---
import {
  AlertTriangle,
  BellRing,
  ChevronDown,
  Crosshair,
  ExternalLink,
  Filter,
  Layers3,
  Lightbulb,
  MapPin,
  Search,
  Settings2,
  Signal,
  Star,
  SlidersHorizontal,
  Wifi,
  X,
} from '@lucide/astro';
import 'leaflet/dist/leaflet.css';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const assetBase = base.endsWith('/') ? base : `${base}/`;
const devices = [
  { id: 'climate-east', name: 'Klima bygg B', type: 'Klima', status: 'alarm', sidebarSummary: '78 % RH · mål 22 C', location: 'Odden, bygg B', coordinate: [58.919324, 5.738736], primary: '78 %', primaryLabel: 'Luftfuktighet', secondary: '22,8 C', secondaryLabel: 'Temperatur', activity: 'RH over 75 % i 3 t 14 min', lastSeen: 'Sist sett nå' },
  { id: 'drying', name: 'Tørkerom B1', type: 'Klima', status: 'normal', sidebarSummary: '22,4 C · mål 22 C', location: 'Odden, bygg B', coordinate: [58.919207, 5.73901], primary: '45 %', primaryLabel: 'Luftfuktighet', secondary: '22,4 C', secondaryLabel: 'Temperatur', activity: 'Normalt tørkeforløp', lastSeen: 'Sist sett nå' },
  { id: 'heating-a', name: 'Varmesløyfe A', type: 'Varme', status: 'normal', sidebarSummary: '21,8 C · mål 22 C', location: 'Odden, dekke bygg A', coordinate: [58.919324, 5.739283], primary: '21,8 C', primaryLabel: 'Temperatur', secondary: '22,0 C', secondaryLabel: 'Ønsket temperatur', activity: 'Holder jevn temperatur i støpesone', lastSeen: 'Sist sett nå', targetTemperature: 22 },
  { id: 'heating-b', name: 'Varmesløyfe B', type: 'Varme', status: 'warning', sidebarSummary: '18,6 C · mål 21 C', location: 'Odden, dekke bygg B', coordinate: [58.919207, 5.739562], primary: '18,6 C', primaryLabel: 'Temperatur', secondary: '21,0 C', secondaryLabel: 'Ønsket temperatur', activity: 'Temperaturen er 2,4 C under mål', lastSeen: 'Sist sett nå', targetTemperature: 21 },
  { id: 'concrete-a12', name: 'Betongstøp A12', type: 'Betong', status: 'normal', sidebarSummary: 'Ferdig om 13 t 40 min', location: 'Odden, dekke bygg A', coordinate: [58.919091, 5.738736], primary: '19,6 C', primaryLabel: 'Temperatur', secondary: '17,8 C', secondaryLabel: 'Minimum', activity: 'Innenfor definert temperaturvindu', lastSeen: 'Sist sett nå', estimate: 'Estimert ferdig om 13 t 40 min' },
  { id: 'concrete-a13', name: 'Betongstøp A13', type: 'Betong', status: 'normal', sidebarSummary: 'Ferdig om 17 t 15 min', location: 'Odden, dekke bygg A', coordinate: [58.918975, 5.73901], primary: '18,9 C', primaryLabel: 'Temperatur', secondary: '17,4 C', secondaryLabel: 'Minimum', activity: 'Modning følger forventet kurve', lastSeen: 'Sist sett nå', estimate: 'Estimert ferdig om 17 t 15 min' },
  { id: 'concrete-b04', name: 'Betongstøp B04', type: 'Betong', status: 'normal', sidebarSummary: 'Ferdig i morgen 14:10', location: 'Odden, dekke bygg B', coordinate: [58.919091, 5.739283], primary: '20,3 C', primaryLabel: 'Temperatur', secondary: '18,2 C', secondaryLabel: 'Minimum', activity: 'Innenfor definert temperaturvindu', lastSeen: 'Sist sett nå', estimate: 'Estimert ferdig i morgen kl. 14:10' },
  { id: 'hoist', name: 'Heisekran', type: 'Utstyr', status: 'normal', sidebarSummary: 'Aktiv nå · 3 t 42 i dag', location: 'Odden, bygg A', coordinate: [58.918975, 5.739562], primary: '3 t 42', primaryLabel: 'Aktiv tid i dag', secondary: '46 %', secondaryLabel: 'Utnyttelse', activity: 'Normal drift de siste 24 timene', lastSeen: 'Sist sett nå', usage: '3 t 42 min aktiv · 2 t 11 min tomgang' },
  { id: 'generator', name: 'Generator 01', type: 'Utstyr', status: 'normal', sidebarSummary: 'Aktiv nå · 1 t 28 i dag', location: 'Odden, riggområde', coordinate: [58.919091, 5.738463], primary: '1 t 28', primaryLabel: 'Aktiv tid i dag', secondary: '28 %', secondaryLabel: 'Utnyttelse', activity: 'Normal drift de siste 24 timene', lastSeen: 'Sist sett nå', usage: '1 t 28 min aktiv · 18 min tomgang' },
  { id: 'scissor-lift', name: 'Sakselift 01', type: 'Utstyr', status: 'normal', sidebarSummary: 'Stoppet · sist aktiv 15:08', location: 'Odden, bygg B', coordinate: [58.919324, 5.738463], primary: '4 t 16', primaryLabel: 'Aktiv tid i dag', secondary: '54 %', secondaryLabel: 'Utnyttelse', activity: 'Planlagt pause i høyden', lastSeen: 'Sist sett 4 min siden', usage: '4 t 16 min aktiv · 1 t 02 min tomgang' },
  { id: 'boom-lift', name: 'Bomlift 01', type: 'Utstyr', status: 'normal', sidebarSummary: 'Aktiv nå · 2 t 05 i dag', location: 'Odden, sørside', coordinate: [58.919091, 5.739835], primary: '2 t 05', primaryLabel: 'Aktiv tid i dag', secondary: '38 %', secondaryLabel: 'Utnyttelse', activity: 'Arbeid på fasade i sør', lastSeen: 'Sist sett nå', usage: '2 t 05 min aktiv · 44 min tomgang' },
];
const alarms = devices.filter((device) => device.status !== 'normal');
const normalCount = devices.filter((device) => device.status === 'normal').length;
const warningCount = devices.filter((device) => device.status === 'warning').length;
const alarmCount = devices.filter((device) => device.status === 'alarm').length;
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="SitePulse - prosjektoversikt for Odden" />
    <title>SitePulse | Veidekke Odden</title>
  </head>
  <body>
    <main class="app-shell">
      <header class="topbar">
        <div class="veidekke-lockup">
          <img src={`${assetBase}images/veidekke.svg`} alt="Veidekke" />
          <span class="vertical-rule"></span>
          <div><strong>SitePulse</strong><span>Odden · Jåttåvågen</span></div>
        </div>
        <div class="top-actions"><button class="report-button" data-report-toggle>Rapport</button><div class="project-switcher-wrap"><button class="project-switcher" data-project-toggle><span data-project-name>Odden</span><ChevronDown size={15} /></button><div class="project-menu" data-project-menu hidden><button data-project="Odden" data-coordinate="58.91944,5.73924">Odden <small>Jåttåvågen</small></button><button data-project="Frysjaparken" data-coordinate="59.965378,10.771529">Frysjaparken <small>Oslo</small></button></div></div></div>
        <div class="operator-lockup">
          <span class="operator-name">Rune Holm</span>
          <span class="avatar">RH</span>
          <div class="zimo-menu-wrap"><button class="zimo-lockup" aria-label="Åpne Zimo-meny" aria-expanded="false" data-zimo-toggle><img src={`${assetBase}images/zimo.svg`} alt="Zimo" /><small>Teknologi</small></button><div class="zimo-menu" data-zimo-menu hidden><a href="https://zimo.no/" target="_blank" rel="noreferrer"><ExternalLink size={15} />Gå til Zimo.no</a><button data-zimo-feedback><Lightbulb size={15} />Send inn forslag</button><button data-zimo-products><Layers3 size={15} />Se lignende produkter</button></div></div>
        </div>
      </header>

      <section class="workspace">
        <aside class="device-sidebar">
          <div class="project-heading">
            <p class="eyebrow">Veidekke prosjekt</p>
            <h1 data-sidebar-project>Odden</h1>
            <p><MapPin size={14} /> <span data-sidebar-location>Nautholmveien 47, Stavanger</span></p>
          </div>

          <div class="sidebar-controls">
            <label class="search-field">
              <Search size={16} />
              <input type="search" placeholder="Søk etter sensor" aria-label="Søk etter sensor" data-device-search />
            </label>
            <div class="filter-menu"><button class="icon-button" aria-label="Vis typefilter" title="Vis typefilter" data-filter-toggle><Filter size={17} /></button><div class="type-filters" data-type-filters hidden>
              <button data-type-filter="all" class="selected">Alle typer</button><button data-type-filter="Klima">Klima</button><button data-type-filter="Varme">Varme</button><button data-type-filter="Utstyr">Utstyr</button><button data-type-filter="Betong">Betong</button>
            </div></div>
          </div>

          <div class="quick-filters" aria-label="Statusfilter">
            <button data-status-filter="all" class="selected">Alle <span>{devices.length}</span></button>
            <button data-status-filter="alarm">Alarm <span>{alarmCount}</span></button>
            <button data-status-filter="warning">Varsel <span>{warningCount}</span></button>
          </div>

          <div class="list-heading"><span>SitePulse-enheter</span><span class="device-count" data-device-count>{devices.length}</span></div>
          <div class="device-list" data-device-list>
            {devices.map((device) => (
              <div class:list={['device-row', { selected: device.id === 'climate-east' }]} data-device-id={device.id} data-device-type={device.type} data-device-status={device.status}>
              <button class="device-select" data-device-select={device.id}>
                <span class:list={['device-symbol', device.status]}><Signal size={15} /></span>
                <span class="device-copy"><strong>{device.name}</strong><small>{device.sidebarSummary}</small></span>
                <span class:list={['status-dot', device.status]} aria-label={device.status}></span>
              </button><button class="favorite-button" aria-label={`Favoritt ${device.name}`} title="Legg til favoritt" data-favorite={device.id}><Star size={15} /></button></div>
            ))}
          </div>

          <div class="sidebar-footnote"><Wifi size={15} /><span>LTE-M · data oppdateres hvert 5. minutt</span></div>
        </aside>

        <section class="map-area" aria-label="Interaktivt prosjektkart for Odden">
          <div id="sitepulse-map" data-devices={JSON.stringify(devices)}></div>
          <div class="map-topline">
            <div class="map-context"><MapPin size={16} /><span data-map-project>Odden · Jåttåvågen</span></div>
            <button class="map-action" aria-label="Sentrer kart på prosjektet" title="Sentrer kart på prosjektet" data-map-home><Crosshair size={17} /></button>
          </div>

          <div class="map-summary"><span class="summary-online"><i></i> {normalCount} normale</span><span class="summary-warning"><i></i> {warningCount} varsel</span><span class="summary-alarm"><i></i> {alarmCount} alarm</span></div>

          <div class="alarm-control">
            <div class="alarm-stack" data-alarm-stack hidden>
              <div class="alarm-stack-heading"><span><AlertTriangle size={16} /> Aktive avvik</span><button aria-label="Lukk alarmoversikt" data-alarm-close><X size={16} /></button></div>
              {alarms.map((device) => (
                <button class="alarm-row" data-alarm-device={device.id}>
                  <span class:list={['status-dot', device.status]}></span>
                  <span><strong>{device.name}</strong><small>{device.activity}</small></span>
                </button>
              ))}
            </div>
            <button class="alarm-bubble has-alarms" aria-label={`Vis ${alarms.length} aktive avvik`} title="Vis aktive alarmer" data-alarm-toggle>
              <BellRing size={19} />
              <span>Alarmer</span>
              <b>{alarms.length}</b>
            </button>
          </div>

          <div class="map-credit">Kartdata © OpenStreetMap-bidragsytere</div>
        </section>

        <aside class="settings-panel" data-settings-panel hidden>
          <div class="settings-heading"><div><p class="eyebrow">SitePulse-innstillinger</p><h2 data-settings-name>Klima bygg B</h2><p data-settings-location>Odden, bygg B</p></div><button class="icon-button" aria-label="Lukk innstillinger" data-settings-close><X size={18} /></button></div>
          <label>Navn<input type="text" data-device-name /></label><label>Sensorprofil<select data-profile-select><option>Utstyr</option><option>Klima</option><option>Varme</option><option>Betong</option><option>Vann</option><option>Eiendel</option><option>Egendefinert</option></select></label>
          <label>Varsling<select data-notification-select><option>SMS</option><option>Push-varsling</option><option>E-post</option><option>Ingen</option></select></label>
          <div class="settings-section"><h3>Godkjent måleområde</h3><div class="range-fields"><label>Nedre grense<input type="number" value="18" data-range-min /></label><label>Øvre grense<input type="number" value="75" data-range-max /></label></div><small data-range-copy>Alarm ved relativ luftfuktighet over 75 % i 30 minutter.</small></div>
          <div class="concrete-estimate" data-concrete-estimate hidden><h3>Betongstøp</h3><strong data-concrete-copy>Estimert ferdig i morgen kl. 10:30</strong><small>Basert på registrert temperaturhistorikk.</small></div>
          <div class="climate-target" data-climate-target hidden><h3>Ønsket temperatur</h3><label>Temperatur i rommet<input type="number" value="22" data-target-temperature /><span>°C</span></label><small>Varsel utløses når målingen ligger utenfor valgt område.</small></div>
          <div class="equipment-usage" data-equipment-usage hidden><h3>Bruk i dag</h3><strong data-equipment-copy>3 t 42 min aktiv</strong><div class="usage-bars"><i style="--bar:42%"></i><i style="--bar:74%"></i><i style="--bar:58%"></i><i style="--bar:88%"></i><i style="--bar:64%"></i><i style="--bar:31%"></i><i style="--bar:53%"></i></div><small>Aktivitet fordelt gjennom arbeidsdagen.</small></div>
          <button class="save-settings" data-settings-save>Lagre innstillinger</button>
        </aside>
      </section>
      <dialog class="zimo-dialog" data-zimo-feedback-dialog>
        <form method="dialog" class="dialog-content" data-feedback-form><div class="dialog-heading"><div><p class="eyebrow">Zimo</p><h2>Send inn forslag</h2></div><button class="icon-button" aria-label="Lukk forslag" value="cancel"><X size={18} /></button></div><label>Hva kan vi forbedre?<textarea placeholder="Skriv forslaget ditt her" required data-feedback-message></textarea></label><p class="dialog-confirmation" data-feedback-confirmation hidden>Takk. Forslaget er registrert og sendt til Zimo.</p><button class="save-settings" type="submit">Send forslag</button></form>
      </dialog>
      <dialog class="zimo-dialog" data-zimo-products-dialog>
        <form method="dialog" class="dialog-content"><div class="dialog-heading"><div><p class="eyebrow">Zimo</p><h2>Lignende produkter</h2></div><button class="icon-button" aria-label="Lukk produktoversikt" value="cancel"><X size={18} /></button></div><div class="product-list"><a href="https://zimo.no/" target="_blank" rel="noreferrer"><strong>Prosjektovervåking</strong><span>Oversikt over eiendeler, klima og varsler på byggeplass.</span><ExternalLink size={15} /></a><a href="https://zimo.no/" target="_blank" rel="noreferrer"><strong>Tilstandsoppfølging</strong><span>Få kontroll på målinger, service og avvik i drift.</span><ExternalLink size={15} /></a><a href="https://zimo.no/" target="_blank" rel="noreferrer"><strong>Rapportering</strong><span>Del beslutningsgrunnlag med prosjekt og kunde.</span><ExternalLink size={15} /></a></div></form>
      </dialog>
    </main>

    <script>
      import L from 'leaflet';

      const mapElement = document.querySelector('#sitepulse-map');
      const mapArea = mapElement.closest('.map-area');
      const devices = JSON.parse(mapElement.dataset.devices);
      let projectCenter = [58.91944, 5.73924];
      const map = L.map(mapElement, { zoomControl: false, attributionControl: false, scrollWheelZoom: true }).setView(projectCenter, 17);
      L.control.zoom({ position: 'bottomleft' }).addTo(map);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, crossOrigin: true }).addTo(map);

      const markers = new Map();
      const escapeHtml = (value) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' })[character]);
      const markerIcon = (device) => L.divIcon({
        className: 'sitepulse-div-icon',
        iconSize: [42, 42],
        iconAnchor: [21, 21],
        popupAnchor: [0, -25],
        html: `<div class="puck-marker ${device.status}"><span>SP</span></div>`,
      });
      const popupMarkup = (device) => `<article class="sensor-popup">
        <div class="sensor-popup-heading"><div><span class="popup-type">${escapeHtml(device.type)}</span><h2>${escapeHtml(device.name)}</h2><p>${escapeHtml(device.location)}</p></div><span class="popup-status ${device.status}"></span></div>
        <div class="popup-metrics"><div><strong>${escapeHtml(device.primary)}</strong><span>${escapeHtml(device.primaryLabel)}</span></div><div><strong>${escapeHtml(device.secondary)}</strong><span>${escapeHtml(device.secondaryLabel)}</span></div></div>
        <p class="popup-activity ${device.status}">${escapeHtml(device.activity)}</p><small>${escapeHtml(device.lastSeen)}</small><button class="popup-settings" data-popup-settings="${device.id}">Innstillinger</button>
      </article>`;
      const updateSelected = (id) => document.querySelectorAll('[data-device-id]').forEach((row) => row.classList.toggle('selected', row.dataset.deviceId === id));
      const settingsPanel = document.querySelector('[data-settings-panel]');
      const selectDevice = (id, openPopup = true) => {
        const device = devices.find((item) => item.id === id);
        const marker = markers.get(id);
        if (!device || !marker) return;
        updateSelected(id);
        if (!settingsPanel.hidden) openSettings(id);
        map.flyTo(device.coordinate, 18, { duration: 0.65 });
        if (openPopup) window.setTimeout(() => marker.openPopup(), 350);
      };

      devices.forEach((device) => {
        const marker = L.marker(device.coordinate, { icon: markerIcon(device), title: device.name, keyboard: true }).addTo(map);
        marker.bindPopup(popupMarkup(device), { closeButton: true, maxWidth: 286, minWidth: 256, className: 'sitepulse-popup' });
        marker.on('click', () => {
          updateSelected(device.id);
          if (!settingsPanel.hidden) openSettings(device.id);
        });
        marker.getElement().addEventListener('click', () => {
          if (!settingsPanel.hidden) openSettings(device.id);
        });
        markers.set(device.id, marker);
      });
      selectDevice('climate-east', false);

      document.querySelectorAll('[data-device-select]').forEach((row) => row.addEventListener('click', () => selectDevice(row.dataset.deviceSelect)));
      const favorites = new Set();
      document.querySelectorAll('[data-favorite]').forEach((button) => button.addEventListener('click', () => { const id = button.dataset.favorite; favorites.has(id) ? favorites.delete(id) : favorites.add(id); button.classList.toggle('active', favorites.has(id)); button.title = favorites.has(id) ? 'Fjern fra favoritter' : 'Legg til favoritt'; const list = document.querySelector('[data-device-list]'); [...list.querySelectorAll('[data-device-id]')].sort((a, b) => Number(favorites.has(b.dataset.deviceId)) - Number(favorites.has(a.dataset.deviceId))).forEach((row) => list.append(row)); }));
      document.querySelector('[data-map-home]').addEventListener('click', () => map.flyTo(projectCenter, 17, { duration: 0.65 }));

      let configuredDevice = devices[0];
      const openSettings = (id) => {
        const device = devices.find((item) => item.id === id);
        if (!device) return;
        configuredDevice = device;
        document.querySelector('[data-settings-name]').textContent = device.name;
        document.querySelector('[data-settings-location]').textContent = device.location;
        document.querySelector('[data-device-name]').value = device.name;
        document.querySelector('[data-profile-select]').value = device.type;
        document.querySelector('[data-concrete-estimate]').hidden = device.type !== 'Betong';
        document.querySelector('[data-climate-target]').hidden = !['Klima', 'Varme'].includes(device.type);
        document.querySelector('[data-equipment-usage]').hidden = device.type !== 'Utstyr';
        document.querySelector('[data-equipment-copy]').textContent = device.usage || 'Ingen bruk registrert i dag';
        document.querySelector('[data-concrete-copy]').textContent = device.estimate || 'Estimat beregnes når målinger foreligger.';
        document.querySelector('[data-target-temperature]').value = device.targetTemperature || 22;
        settingsPanel.hidden = false;
        mapArea.classList.add('settings-open');
        map.invalidateSize();
      };
      map.on('popupopen', (event) => event.popup.getElement().querySelector('[data-popup-settings]').addEventListener('click', () => openSettings(event.popup.getElement().querySelector('[data-popup-settings]').dataset.popupSettings)));
      document.querySelector('[data-settings-close]').addEventListener('click', () => { settingsPanel.hidden = true; mapArea.classList.remove('settings-open'); map.invalidateSize(); });
      document.querySelector('[data-settings-save]').addEventListener('click', () => { configuredDevice.type = document.querySelector('[data-profile-select]').value; configuredDevice.name = document.querySelector('[data-device-name]').value.trim() || configuredDevice.name; configuredDevice.targetTemperature = document.querySelector('[data-target-temperature]').value; document.querySelector(`[data-device-id="${configuredDevice.id}"] .device-copy strong`).textContent = configuredDevice.name; markers.get(configuredDevice.id).setPopupContent(popupMarkup(configuredDevice)); settingsPanel.hidden = true; mapArea.classList.remove('settings-open'); map.invalidateSize(); });
      document.querySelector('[data-profile-select]').addEventListener('change', (event) => { document.querySelector('[data-concrete-estimate]').hidden = event.target.value !== 'Betong'; document.querySelector('[data-climate-target]').hidden = !['Klima', 'Varme'].includes(event.target.value); document.querySelector('[data-equipment-usage]').hidden = event.target.value !== 'Utstyr'; });

      const filterToggle = document.querySelector('[data-filter-toggle]');
      const typeFilters = document.querySelector('[data-type-filters]');
      filterToggle.addEventListener('click', () => { typeFilters.hidden = !typeFilters.hidden; filterToggle.classList.toggle('active', !typeFilters.hidden); });

      let currentType = 'all';
      let currentStatus = 'all';
      const applyFilters = () => {
        const query = document.querySelector('[data-device-search]').value.toLowerCase().trim();
        let visible = 0;
        document.querySelectorAll('[data-device-id]').forEach((row) => {
          const isVisible = (currentType === 'all' || row.dataset.deviceType === currentType) && (currentStatus === 'all' || row.dataset.deviceStatus === currentStatus) && row.textContent.toLowerCase().includes(query);
          row.hidden = !isVisible;
          if (isVisible) visible += 1;
        });
        document.querySelector('[data-device-count]').textContent = visible;
      };
      document.querySelector('[data-device-search]').addEventListener('input', applyFilters);
      document.querySelectorAll('[data-type-filter]').forEach((button) => button.addEventListener('click', () => { currentType = button.dataset.typeFilter; document.querySelectorAll('[data-type-filter]').forEach((item) => item.classList.toggle('selected', item === button)); applyFilters(); }));
      document.querySelectorAll('[data-status-filter]').forEach((button) => button.addEventListener('click', () => { currentStatus = button.dataset.statusFilter; document.querySelectorAll('[data-status-filter]').forEach((item) => item.classList.toggle('selected', item === button)); applyFilters(); }));

      const alarmStack = document.querySelector('[data-alarm-stack]');
      document.querySelector('[data-alarm-toggle]').addEventListener('click', () => { alarmStack.hidden = !alarmStack.hidden; });
      document.querySelector('[data-alarm-close]').addEventListener('click', () => { alarmStack.hidden = true; });
      document.querySelectorAll('[data-alarm-device]').forEach((alarm) => alarm.addEventListener('click', () => { alarmStack.hidden = true; selectDevice(alarm.dataset.alarmDevice); }));

      const projectMenu = document.querySelector('[data-project-menu]');
      document.querySelector('[data-project-toggle]').addEventListener('click', () => { projectMenu.hidden = !projectMenu.hidden; });
      document.querySelectorAll('[data-project]').forEach((project) => project.addEventListener('click', () => {
        const [lat, lng] = project.dataset.coordinate.split(',').map(Number);
        projectCenter = [lat, lng];
        const isOdden = project.dataset.project === 'Odden';
        document.querySelector('[data-project-name]').textContent = project.dataset.project;
        document.querySelector('[data-sidebar-project]').textContent = project.dataset.project;
        document.querySelector('[data-sidebar-location]').textContent = isOdden ? 'Nautholmveien 47, Stavanger' : 'Frysjaveien, Oslo';
        document.querySelector('[data-map-project]').textContent = isOdden ? 'Odden · Jåttåvågen' : 'Frysjaparken · Oslo';
        projectMenu.hidden = true;
        map.flyTo(projectCenter, 17, { duration: 0.65 });
      }));
      document.querySelector('[data-report-toggle]').addEventListener('click', () => { window.location.hash = 'rapport'; document.querySelector('[data-report-toggle]').classList.toggle('active'); });

      const zimoMenu = document.querySelector('[data-zimo-menu]');
      const zimoToggle = document.querySelector('[data-zimo-toggle]');
      zimoToggle.addEventListener('click', (event) => { event.stopPropagation(); zimoMenu.hidden = !zimoMenu.hidden; zimoToggle.setAttribute('aria-expanded', String(!zimoMenu.hidden)); });
      document.addEventListener('click', (event) => { if (!event.target.closest('.zimo-menu-wrap')) { zimoMenu.hidden = true; zimoToggle.setAttribute('aria-expanded', 'false'); } });
      const feedbackDialog = document.querySelector('[data-zimo-feedback-dialog]');
      document.querySelector('[data-zimo-feedback]').addEventListener('click', () => { zimoMenu.hidden = true; zimoToggle.setAttribute('aria-expanded', 'false'); feedbackDialog.showModal(); });
      document.querySelector('[data-zimo-products]').addEventListener('click', () => { zimoMenu.hidden = true; zimoToggle.setAttribute('aria-expanded', 'false'); document.querySelector('[data-zimo-products-dialog]').showModal(); });
      document.querySelector('[data-feedback-form]').addEventListener('submit', (event) => { event.preventDefault(); document.querySelector('[data-feedback-confirmation]').hidden = false; document.querySelector('[data-feedback-message]').value = ''; });
    </script>
  </body>
</html>
